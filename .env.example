# OpenRouter server-side keys. Keep these secret and never put them in the frontend.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_API_KEY_1=""
OPENROUTER_API_KEY_2=""
OPENROUTER_API_KEY_3=""
OPENROUTER_API_KEY_4=""
OPENROUTER_API_KEY_5=""

# Free-only by default.
OPENROUTER_ALLOW_PAID="false"
OPENROUTER_MODELS="openrouter/free"

# Optional frontend/API configuration.
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Do not set a paid PDF parser. OpenRouter accepts PDF file input directly.
