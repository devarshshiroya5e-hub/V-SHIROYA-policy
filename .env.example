# NVIDIA server-side key. Keep this secret and NEVER put it in the frontend.
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"
NVIDIA_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"

# Fast PDF rendering / NVIDIA page scanning.
NVIDIA_PAGE_CONCURRENCY="2"
NVIDIA_PDF_SCALE="1.35"
NVIDIA_PAGE_TEXT_LIMIT="18000"
NVIDIA_FINAL_TEXT_LIMIT="180000"
NVIDIA_OCR_MAX_TOKENS="4096"
NVIDIA_MAX_TOKENS="6000"
NVIDIA_TIMEOUT_MS="90000"
NVIDIA_MAX_RETRIES="3"

# Existing application controls.
BULK_CONCURRENCY="2"
CORS_ALLOW_ALL="true"
APP_URL="https://v-shiroya-policy.onrender.com"
FRONTEND_URL="https://v-shiroya-insurance.web.app"
FIREBASE_APP_URL="https://v-shiroya-insurance.web.app"
MAX_FILE_BYTES="104857600"
MAX_BODY_SIZE="110mb"
