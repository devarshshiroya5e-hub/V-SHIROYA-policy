# Required: OpenRouter API key used only by the server.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Optional: comma-separated fallback models. The first available model is used.
OPENROUTER_MODELS="google/gemini-2.5-flash"

# Optional PDF processing engine: mistral-ocr (best OCR), cloudflare-ai, or native when supported.
OPENROUTER_PDF_ENGINE="mistral-ocr"

# Public application URL used by OpenRouter request metadata.
APP_URL="http://localhost:3000"
