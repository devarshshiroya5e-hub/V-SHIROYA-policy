# Required: OpenRouter API key used only by the server.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Free-only by default. Uses OpenRouter's free router and cannot select paid models.
OPENROUTER_ALLOW_PAID="false"
OPENROUTER_MODELS="openrouter/free"

# Optional frontend/API configuration.
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Do not set a paid PDF parser. OpenRouter accepts PDF file input directly.
