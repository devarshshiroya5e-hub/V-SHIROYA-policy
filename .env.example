# OpenRouter server-side keys. Keep these secret and never put them in the frontend.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_API_KEY_1=""
OPENROUTER_API_KEY_2=""
OPENROUTER_API_KEY_3=""
OPENROUTER_API_KEY_4=""
OPENROUTER_API_KEY_5=""

# Free-only AI ensemble. Use three separate OpenRouter keys when available.
# The application should use three different free models or three free-router requests.
OPENROUTER_ALLOW_PAID="false"
OPENROUTER_MODELS="openrouter/free,openrouter/free,openrouter/free"
AI_ENSEMBLE_SIZE="3"

# Process two documents at a time on the server. This is intentionally lower than
# the browser's old parallel upload behavior because each document can invoke 3 AI calls.
# It improves reliability and prevents 429/rate-limit failures that caused missing PDFs.
BULK_CONCURRENCY="2"

# Retry transient free-model failures. The server should retry 429/5xx failures.
AI_MAX_RETRIES="3"
AI_RETRY_DELAY_MS="800"

# Force the free PDF parser so PDF scanning does not silently use paid OCR.
OPENROUTER_PDF_ENGINE="cloudflare-ai"

# Allow browser access to the public API.
CORS_ALLOW_ALL="true"

APP_URL="https://v-shiroya-policy.onrender.com"
FRONTEND_URL="https://v-shiroya-insurance.web.app"
FIREBASE_APP_URL="https://v-shiroya-insurance.web.app"

# Upload limits. Keep MAX_BODY above the largest file because base64 adds overhead.
MAX_FILE_BYTES="104857600"
MAX_BODY_SIZE="110mb"